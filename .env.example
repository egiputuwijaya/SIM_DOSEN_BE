# Salin file ini menjadi .env lalu sesuaikan dengan lingkungan Anda.
# .env dipakai untuk lingkungan lokal/development; di production lebih
# baik set variabel environment asli (SetEnv Apache / fastcgi_param PHP-FPM /
# shell export), karena variabel asli selalu lebih prioritas daripada file .env.

# --- Database (MySQL / MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_dosen
DB_USERNAME=root
# Password kosong diperbolehkan (mis. XAMPP default): biarkan kosong atau hapus tanda #.
#DB_PASSWORD=
#DB_PASSWORD="rahasia-bukan-di-sini"

# Nama variabel lama masih didukung sebagai fallback:
# DB_NAME (-> DB_DATABASE), DB_USER (-> DB_USERNAME), DB_PASS (-> DB_PASSWORD).

# --- SSO: login menggunakan SIM_MAHASISWA_BE ---
# Secret APP_KEY yang SAMA PERSIS dengan .env SIM_MAHASISWA_BE.
# Tanpa ini semua endpoint /api/* ditolak (401/500).
SSO_APP_KEY=
# (Opsional, mode hibrida) Base URL SIM_MAHASISWA_BE untuk verifikasi
# tambahan pada aksi sensitif (PUT/PATCH/DELETE) via GET /api/v1/verify.
# Kosongkan = verifikasi lokal (HMAC) saja.
SSO_BASE_URL=
# Role yang boleh menulis data dosen (dipisah koma)
SSO_WRITE_ROLES=ADMIN,OPERATOR_PRODI

# --- CORS: origin frontend yang diizinkan (dipisah koma) ---
# Contoh produksi: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
